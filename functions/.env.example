# Firebase Functions Environment Variables Example
# Copy this file to .env and fill in your actual values

# iOS App Store Connect API
IOS_KEY_ID=YOUR_KEY_ID_HERE
IOS_ISSUER_ID=YOUR_ISSUER_ID_HERE
IOS_BUNDLE_ID=com.gomath.mathlab
# IOS_PRIVATE_KEY is stored in Firebase Functions config, not in .env

# Android Google Play
ANDROID_PACKAGE_NAME=com.gomath.mathlab
# ANDROID_SERVICE_ACCOUNT_KEY is stored in Firebase Functions config, not in .env

# Firebase Project
FIREBASE_PROJECT_ID=mathlab-prod

# Environment
NODE_ENV=production

# API URLs
APP_STORE_VERIFY_URL=https://buy.itunes.apple.com/verifyReceipt
APP_STORE_SANDBOX_URL=https://sandbox.itunes.apple.com/verifyReceipt
GOOGLE_PLAY_API_URL=https://androidpublisher.googleapis.com/androidpublisher/v3

# Webhook Secrets (generated by Apple/Google)
IOS_WEBHOOK_SECRET=YOUR_IOS_WEBHOOK_SECRET
ANDROID_TOPIC_NAME=YOUR_ANDROID_TOPIC_NAME
