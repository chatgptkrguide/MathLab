rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // 헬퍼 함수
    // ============================================

    // 인증된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 본인 데이터인지 확인
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // 관리자인지 확인
    function isAdmin() {
      return request.auth.token.admin == true;
    }

    // 데이터 크기 제한 (1MB)
    function withinSizeLimit() {
      return request.resource.size() < 1024 * 1024;
    }

    // ============================================
    // Users Collection
    // ============================================
    match /users/{userId} {
      // 읽기: 인증된 사용자는 모든 사용자 프로필 읽기 가능 (리그, 친구 기능)
      allow read: if isAuthenticated();

      // 쓰기: 본인 데이터만 수정 가능
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId) && withinSizeLimit();
      allow delete: if isAuthenticated() && isOwner(userId);

      // 사용자 통계 (읽기 전용, Functions만 쓰기)
      match /stats/{statId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if false; // Only Cloud Functions
      }

      // 학습 진행도
      match /progress/{lessonId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
                      && request.resource.data.keys().hasAll(['lessonId', 'completedAt'])
                      && request.resource.data.completedAt is timestamp;
        allow update: if isAuthenticated() && isOwner(userId)
                      && request.resource.data.completedAt is timestamp;
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      // 오답 노트
      match /wrongAnswers/{answerId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }

      // 사용자 설정
      match /settings/{settingId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }

      // 알림 토큰
      match /fcmTokens/{tokenId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }
    }

    // ============================================
    // Lessons Collection (읽기 전용)
    // ============================================
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin(); // 관리자만 레슨 생성/수정

      // 문제들
      match /problems/{problemId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
      }
    }

    // ============================================
    // Leagues Collection
    // ============================================
    match /leagues/{leagueId} {
      // 읽기: 인증된 사용자 모두 가능
      allow read: if isAuthenticated();

      // 쓰기: Cloud Functions만 가능
      allow write: if false;

      // 리그 참가자
      match /participants/{userId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only Cloud Functions
      }
    }

    // ============================================
    // Messages Collection
    // ============================================
    match /messages/{conversationId} {
      // 대화 참가자만 읽기 가능
      allow read: if isAuthenticated()
                  && request.auth.uid in resource.data.participantIds;

      // 대화 생성
      allow create: if isAuthenticated()
                    && request.auth.uid in request.resource.data.participantIds;

      // 대화 정보
      match /info/{docId} {
        allow read: if isAuthenticated()
                    && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participantIds;
        allow write: if isAuthenticated()
                     && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participantIds;
      }

      // 메시지들
      match /messages/{messageId} {
        allow read: if isAuthenticated()
                    && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participantIds;
        allow create: if isAuthenticated()
                      && request.auth.uid in get(/databases/$(database)/documents/messages/$(conversationId)).data.participantIds
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.createdAt == request.time;
        allow update, delete: if false; // 메시지는 수정/삭제 불가
      }
    }

    // ============================================
    // Friends Collection
    // ============================================
    match /friends/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);

      match /requests/{requestId} {
        // 본인의 친구 요청만 읽기/쓰기
        allow read: if isAuthenticated() && isOwner(userId);
        allow create: if isAuthenticated() && isOwner(userId)
                      && request.resource.data.fromUserId == request.auth.uid;
        allow update: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }

      match /list/{friendId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow write: if isAuthenticated() && isOwner(userId);
      }
    }

    // ============================================
    // Notifications Collection
    // ============================================
    match /notifications/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false; // Only Cloud Functions can write

      match /history/{notificationId} {
        allow read: if isAuthenticated() && isOwner(userId);
        allow update: if isAuthenticated() && isOwner(userId); // 읽음 표시
        allow create, delete: if false;
      }
    }

    // ============================================
    // Achievements Collection
    // ============================================
    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /userAchievements/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isOwner(userId);

      match /unlocked/{achievementId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && isOwner(userId);
        allow update, delete: if false;
      }
    }

    // ============================================
    // Daily Rewards Collection
    // ============================================
    match /dailyRewards/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if false; // Only Cloud Functions
    }

    // ============================================
    // Analytics Events (쓰기 전용)
    // ============================================
    match /analytics/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
