rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ============================================
    // 헬퍼 함수
    // ============================================

    // 인증된 사용자인지 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 본인 파일인지 확인
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // 파일 크기 제한 (10MB)
    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // 이미지 파일인지 확인
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // PDF 파일인지 확인
    function isPDF() {
      return request.resource.contentType == 'application/pdf';
    }

    // 허용된 파일 형식인지 확인
    function isValidFileType() {
      return isImage() || isPDF();
    }

    // ============================================
    // 사용자 프로필 이미지
    // ============================================
    match /users/{userId}/profile/{fileName} {
      // 읽기: 모든 인증된 사용자
      allow read: if isAuthenticated();

      // 쓰기: 본인만, 이미지 파일만, 10MB 이하
      allow create, update: if isAuthenticated()
                            && isOwner(userId)
                            && isImage()
                            && isValidSize();

      // 삭제: 본인만
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // 과제 사진
    // ============================================
    match /users/{userId}/assignments/{assignmentId}/{fileName} {
      // 읽기: 본인만
      allow read: if isAuthenticated() && isOwner(userId);

      // 쓰기: 본인만, 이미지 또는 PDF, 10MB 이하
      allow create: if isAuthenticated()
                    && isOwner(userId)
                    && isValidFileType()
                    && isValidSize();

      // 수정/삭제: 본인만
      allow update, delete: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // 주간 테스트 OMR 이미지
    // ============================================
    match /users/{userId}/weekly_tests/{testId}/{fileName} {
      // 읽기: 본인만
      allow read: if isAuthenticated() && isOwner(userId);

      // 쓰기: 본인만, 이미지 파일만, 10MB 이하
      allow create: if isAuthenticated()
                    && isOwner(userId)
                    && isImage()
                    && isValidSize();

      // 수정/삭제: 본인만
      allow update, delete: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // 기타 사용자 파일
    // ============================================
    match /users/{userId}/files/{allPaths=**} {
      // 읽기: 본인만
      allow read: if isAuthenticated() && isOwner(userId);

      // 쓰기: 본인만, 허용된 파일 형식, 10MB 이하
      allow create, update: if isAuthenticated()
                            && isOwner(userId)
                            && isValidFileType()
                            && isValidSize();

      // 삭제: 본인만
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // ============================================
    // 공개 리소스 (앱 리소스, 아이콘 등)
    // ============================================
    match /public/{allPaths=**} {
      // 읽기: 모든 인증된 사용자
      allow read: if isAuthenticated();

      // 쓰기: 차단 (관리자 콘솔에서만 업로드)
      allow write: if false;
    }

    // ============================================
    // 레슨 리소스 (문제 이미지, 설명 이미지 등)
    // ============================================
    match /lessons/{lessonId}/{allPaths=**} {
      // 읽기: 모든 인증된 사용자
      allow read: if isAuthenticated();

      // 쓰기: 차단 (관리자 콘솔에서만 업로드)
      allow write: if false;
    }

    // ============================================
    // 업적 뱃지 이미지
    // ============================================
    match /badges/{badgeId}/{fileName} {
      // 읽기: 모든 인증된 사용자
      allow read: if isAuthenticated();

      // 쓰기: 차단 (관리자 콘솔에서만 업로드)
      allow write: if false;
    }
  }
}
