# MathLab Flutter App Environment Variables
# 실제 값은 .env 파일에 저장하세요 (절대 커밋하지 마세요!)

# API Configuration
API_BASE_URL=http://localhost:8080/api/v1
# Production: https://api.mathlab.app/api/v1

# Social Login Keys
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Firebase Cloud Messaging
FCM_WEB_PUSH_KEY=your_fcm_web_push_key_here
FCM_SENDER_ID=your_fcm_sender_id_here

# App Configuration
APP_ENV=development
# development | staging | production

# Debug
ENABLE_LOGGING=true

# 보안 주의사항:
# 1. .env 파일은 절대 git에 커밋하지 마세요
# 2. 실제 API 키를 이 파일에 입력하지 마세요
# 3. 로컬 개발용 .env 파일을 만들어 실제 값을 입력하세요
# 4. Production 환경에서는 환경 변수나 Secret Manager를 사용하세요
