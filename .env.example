# MathLab 환경 변수 템플릿
#
# 사용 방법:
# 1. 이 파일을 .env로 복사하세요: cp .env.example .env
# 2. 아래 값들을 실제 값으로 교체하세요
# 3. .env 파일은 절대 Git에 커밋하지 마세요!

# ========================================
# Firebase 설정
# ========================================
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_APP_ID=your_firebase_app_id_here
FIREBASE_MESSAGING_SENDER_ID=your_sender_id_here
FIREBASE_PROJECT_ID=your_project_id_here
FIREBASE_STORAGE_BUCKET=your_storage_bucket_here

# ========================================
# Google Sign-In
# ========================================
GOOGLE_CLIENT_ID_IOS=your_google_ios_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID_ANDROID=your_google_android_client_id.apps.googleusercontent.com

# ========================================
# API 엔드포인트
# ========================================
API_BASE_URL=https://api.mathlab.com
API_BASE_URL_DEV=http://localhost:3000

# ========================================
# 앱 설정
# ========================================
APP_ENV=development
DEBUG_MODE=true
