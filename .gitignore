/assets/AssetManifest.*
/assets/FontManifest.json
/assets/NOTICES
/assets/packages/
/assets/shaders/
/flutter_bootstrap.js
/flutter_service_worker.js
/flutter.js
/main.dart.js
/version.json

# Design files (large PNG files)
*.png
*.jpg
*.jpeg
*.gif

# Exceptions for small icons
!**/assets/icons/*.png
!**/assets/images/*.png
!**/assets/images/**/*.png
!web/icons/*.png
!web/favicon.png
.vercel

# Backup files
*.bak
*.backup
*.old

# Auto-generated config files
*.deeplink-config
firestore.indexes.json

# ========================================
# 보안 관련 파일 (SECURITY SENSITIVE)
# ========================================

# 환경 변수 파일
.env
.env.local
.env.production
.env.*.local

# Firebase 설정 파일 (API 키 포함)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Android 서명 키 파일
*.jks
*.keystore
key.properties
android/key.properties

# iOS 인증서 및 프로비저닝
*.p12
*.cer
*.mobileprovision
*.certSigningRequest
ios/Runner/GoogleService-Info.plist
ios/exportOptions.plist

# API Keys 및 Secrets
**/secrets.json
**/credentials.json
api_keys.dart
secrets.dart

# 소셜 로그인 설정 (OAuth)
oauth_config.json
kakao_config.json
ios/Flutter/KakaoSecrets.xcconfig

# Flutter linux ephemeral plugin symlinks (자동 생성)
linux/flutter/ephemeral/

# Firebase Admin Key (보안)
firebase-admin-key.json
firebase*.json
!firebase.json

# 환경변수 복사본
.env 2

# Setup 문서 (보안 정보 포함)
FIREBASE_SETUP.md
KAKAO_LOGIN_SETUP.md
FIREBASE_SERVICES_SETUP.md

# ========================================
# 추가 보안 패턴 (SECURITY ENHANCEMENT)
# ========================================

# 인증서 및 암호화 키
*.key
*.pem
*.cert
*.crt
*.der

# 비밀 설정 파일
.secret
.secrets
*_secret.dart
*_secrets.dart
secrets_*.dart
config/secrets.yaml
config/credentials.yaml

# 배포 및 프로덕션 설정
deployment_config.json
production_config.json
*_prod.json
*.prod.yaml

# 백업 파일 (민감정보 포함 가능)
*_backup.*
*.backup.*
backup_*.*

# 로그 파일 (민감정보 포함 가능)
*.log.*
logs/
crash_logs/
error_logs/

# 테스트 데이터 (실제 데이터 포함 가능)
test_data/
sample_data/
fixtures/*.prod.*

