# Design files (large PNG files)
*.png
*.jpg
*.jpeg
*.gif

# Exceptions for small icons
!**/assets/icons/*.png
!**/assets/images/*.png
!web/icons/*.png
!web/favicon.png
.vercel

# Backup files
*.bak
*.backup
*.old

# Auto-generated config files
*.deeplink-config
firestore.indexes.json

# ========================================
# 보안 관련 파일 (SECURITY SENSITIVE)
# ========================================

# 환경 변수 파일
.env
.env.local
.env.production
.env.*.local

# Firebase 설정 파일 (API 키 포함)
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Android 서명 키 파일
*.jks
*.keystore
key.properties
android/key.properties

# iOS 인증서 및 프로비저닝
*.p12
*.cer
*.mobileprovision
*.certSigningRequest
ios/Runner/GoogleService-Info.plist
ios/exportOptions.plist

# API Keys 및 Secrets
**/secrets.json
**/credentials.json
api_keys.dart
secrets.dart

# 소셜 로그인 설정 (OAuth)
oauth_config.json
kakao_config.json

# Firebase Admin Key (보안)
firebase-admin-key.json
firebase*.json
!firebase.json

# 환경변수 복사본
.env 2

# Setup 문서 (보안 정보 포함)
FIREBASE_SETUP.md
KAKAO_LOGIN_SETUP.md
FIREBASE_SERVICES_SETUP.md
