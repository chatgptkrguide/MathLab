import 'package:flutter_test/flutter_test.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:mathlab/data/models/models.dart';
import 'package:mathlab/data/providers/study_timer_provider.dart';

void main() {
  group('StudyTimerProvider', () {
    late ProviderContainer container;

    setUp(() {
      container = ProviderContainer();
    });

    tearDown(() {
      container.dispose();
    });

    test('initial state should have zero elapsed time', () {
      final timerState = container.read(studyTimerProvider);
      expect(timerState.elapsedSeconds, 0);
      expect(timerState.isRunning, false);
      expect(timerState.activityType, StudyActivityType.problemSolving);
    });

    test('startTimer should set isRunning to true', () async {
      final notifier = container.read(studyTimerProvider.notifier);

      await notifier.startTimer(StudyActivityType.lesson);

      final state = container.read(studyTimerProvider);
      expect(state.isRunning, true);
      expect(state.activityType, StudyActivityType.lesson);
    });

    test('stopTimer should set isRunning to false', () async {
      final notifier = container.read(studyTimerProvider.notifier);

      await notifier.startTimer(StudyActivityType.problemSolving);
      await notifier.stopTimer();

      final state = container.read(studyTimerProvider);
      expect(state.isRunning, false);
    });

    test('pauseTimer should pause the timer', () async {
      final notifier = container.read(studyTimerProvider.notifier);

      await notifier.startTimer(StudyActivityType.review);
      await Future.delayed(const Duration(milliseconds: 100));
      notifier.pauseTimer();

      final state = container.read(studyTimerProvider);
      expect(state.isRunning, false);
      // Timer should have accumulated some time
      expect(state.elapsedSeconds, greaterThan(0));
    });

    test('resumeTimer should resume from paused state', () async {
      final notifier = container.read(studyTimerProvider.notifier);

      await notifier.startTimer(StudyActivityType.problemSolving);
      await Future.delayed(const Duration(milliseconds: 100));
      notifier.pauseTimer();

      final pausedTime = container.read(studyTimerProvider).elapsedSeconds;

      notifier.resumeTimer();
      await Future.delayed(const Duration(milliseconds: 100));

      final state = container.read(studyTimerProvider);
      expect(state.isRunning, true);
      expect(state.elapsedSeconds, greaterThanOrEqualTo(pausedTime));
    });

    test('resetTimer should reset elapsed time to zero', () async {
      final notifier = container.read(studyTimerProvider.notifier);

      await notifier.startTimer(StudyActivityType.lesson);
      await Future.delayed(const Duration(milliseconds: 100));
      notifier.resetTimer();

      final state = container.read(studyTimerProvider);
      expect(state.elapsedSeconds, 0);
      expect(state.isRunning, false);
    });

    test('different activity types should be tracked correctly', () async {
      final notifier = container.read(studyTimerProvider.notifier);

      // Test lesson activity
      await notifier.startTimer(StudyActivityType.lesson);
      expect(container.read(studyTimerProvider).activityType,
             StudyActivityType.lesson);

      await notifier.stopTimer();

      // Test review activity
      await notifier.startTimer(StudyActivityType.review);
      expect(container.read(studyTimerProvider).activityType,
             StudyActivityType.review);

      await notifier.stopTimer();

      // Test wrong answer review activity
      await notifier.startTimer(StudyActivityType.wrongAnswerReview);
      expect(container.read(studyTimerProvider).activityType,
             StudyActivityType.wrongAnswerReview);
    });

    test('study session should be saved when timer stops', () async {
      final notifier = container.read(studyTimerProvider.notifier);

      await notifier.startTimer(StudyActivityType.problemSolving);
      await Future.delayed(const Duration(milliseconds: 100));
      await notifier.stopTimer();

      // Check if session history is updated
      final sessions = await container.read(sessionHistoryProvider.future);
      expect(sessions, isNotEmpty);

      final lastSession = sessions.last;
      expect(lastSession.activityType, StudyActivityType.problemSolving);
      expect(lastSession.durationSeconds, greaterThan(0));
    });

    test('daily stats should accumulate study time', () async {
      final notifier = container.read(studyTimerProvider.notifier);
      final today = DateTime.now();

      // First session
      await notifier.startTimer(StudyActivityType.problemSolving);
      await Future.delayed(const Duration(milliseconds: 100));
      await notifier.stopTimer();

      // Second session
      await notifier.startTimer(StudyActivityType.lesson);
      await Future.delayed(const Duration(milliseconds: 100));
      await notifier.stopTimer();

      // Check daily stats
      final stats = await container.read(dailyStudyStatsProvider(today).future);

      expect(stats, isNotNull);
      expect(stats!.totalSeconds, greaterThan(0));
      expect(stats.sessionCount, equals(2));
      expect(stats.activityDurations.keys,
             containsAll([StudyActivityType.problemSolving, StudyActivityType.lesson]));
    });

    test('weekly stats should aggregate multiple days', () async {
      final notifier = container.read(studyTimerProvider.notifier);
      final weekStart = DateTime.now().subtract(
        Duration(days: DateTime.now().weekday - 1),
      );

      // Add study sessions
      await notifier.startTimer(StudyActivityType.problemSolving);
      await Future.delayed(const Duration(milliseconds: 100));
      await notifier.stopTimer();

      // Check weekly stats
      final weeklyStats = await container.read(
        weeklyStudyStatsProvider(weekStart).future,
      );

      expect(weeklyStats.totalSeconds, greaterThan(0));
      expect(weeklyStats.dailyStats, isNotEmpty);
      expect(weeklyStats.averageSecondsPerDay, greaterThanOrEqualTo(0));
    });
  });

  group('StudyActivityType', () {
    test('should have correct label for each type', () {
      expect(StudyActivityType.problemSolving.label, '문제 풀이');
      expect(StudyActivityType.lesson.label, '레슨 학습');
      expect(StudyActivityType.review.label, '복습');
      expect(StudyActivityType.wrongAnswerReview.label, '오답 복습');
      expect(StudyActivityType.other.label, '기타');
    });
  });

  group('StudyTimerState', () {
    test('should create valid state with all fields', () {
      final state = StudyTimerState(
        elapsedSeconds: 100,
        isRunning: true,
        activityType: StudyActivityType.lesson,
      );

      expect(state.elapsedSeconds, 100);
      expect(state.isRunning, true);
      expect(state.activityType, StudyActivityType.lesson);
    });

    test('should support copyWith for state updates', () {
      final initial = StudyTimerState(
        elapsedSeconds: 50,
        isRunning: false,
        activityType: StudyActivityType.problemSolving,
      );

      final updated = initial.copyWith(
        elapsedSeconds: 100,
        isRunning: true,
      );

      expect(updated.elapsedSeconds, 100);
      expect(updated.isRunning, true);
      expect(updated.activityType, StudyActivityType.problemSolving);
    });
  });
}
