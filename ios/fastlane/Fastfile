default_platform(:ios)

require "json"

# 프로젝트 루트 (ios/fastlane → ../../)
PROJECT_ROOT = File.expand_path("../..", __dir__)

def shorebird_cmd(args)
  # Fastlane(Bundle) 환경변수가 자식 프로세스(flutter/pod)로 전파되면
  # CocoaPods가 잘못된 Ruby로 실행되어 "CocoaPods is broken" 에러 발생.
  # BUNDLE_*/GEM_* 변수를 제거하고 PATH에 Homebrew 경로 보장.
  env_clean = "unset BUNDLE_GEMFILE BUNDLE_BIN_PATH BUNDLE_PATH BUNDLER_ORIG_BUNDLE_BIN_PATH BUNDLER_ORIG_BUNDLE_GEMFILE BUNDLER_ORIG_BUNDLE_PATH BUNDLER_ORIG_PATH BUNDLER_ORIG_RUBYLIB BUNDLER_ORIG_RUBYOPT BUNDLER_ORIG_GEM_HOME BUNDLER_ORIG_GEM_PATH RUBYOPT RUBYLIB GEM_HOME GEM_PATH"
  path_setup = "export PATH=\"$HOME/.shorebird/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:$PATH\""
  "cd #{PROJECT_ROOT} && #{env_clean} && #{path_setup} && yes | shorebird #{args}"
end

def release_notes(prefix)
  commit_msg = `git -C #{PROJECT_ROOT} log -1 --pretty=%s 2>/dev/null`.strip
  commit_msg = "New build" if commit_msg.empty?
  "#{prefix} #{Time.now.strftime('%Y%m%d%H%M')} - #{commit_msg}"
end

def latest_ipa
  path = Dir["#{PROJECT_ROOT}/build/ios/ipa/*.ipa"].first
  UI.user_error!("IPA file not found under build/ios/ipa/. Run shorebird/flutter build first.") if path.nil?
  path
end

# App Store Connect API Key (전역 저장, Apple 웹 로그인 불필요)
# 로컬: ~/.appstoreconnect/api_key.json (git 추적 제외, Fastlane 기본 경로)
# CI: APP_STORE_CONNECT_API_KEY_ID, APP_STORE_CONNECT_API_ISSUER_ID, APP_STORE_CONNECT_API_KEY_BASE64 환경변수
def ensure_api_key
  local_json = File.expand_path("~/.appstoreconnect/api_key.json")
  if File.exist?(local_json) && ENV["APP_STORE_CONNECT_API_KEY_ID"].nil?
    key = JSON.parse(File.read(local_json))
    app_store_connect_api_key(
      key_id: key["key_id"],
      issuer_id: key["issuer_id"],
      key_content: key["key"],
      duration: 1200,
      in_house: false
    )
  else
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_API_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_API_ISSUER_ID"),
      key_content: ENV["APP_STORE_CONNECT_API_KEY_BASE64"],
      is_key_content_base64: true,
      duration: 1200,
      in_house: false
    )
  end
end

platform :ios do
  # ========================================
  # App Store Connect 앱 생성 (최초 1회)
  # ========================================

  desc "Create app on App Store Connect (one-time)"
  lane :create_app do
    ensure_api_key
    produce(
      app_identifier: "com.gomath.mathlab",
      app_name: "MathLab",
      language: "Korean",
      app_version: "1.0.0",
      sku: "mathlab-gomath"
    )
    UI.success("✅ App Store Connect에 앱 생성 완료!")
  end

  # ========================================
  # Firebase App Distribution (테스터 배포)
  # ========================================

  desc "Build and distribute to Firebase App Distribution"
  lane :distribute do
    # exportOptions plist 명시: pbxproj manual signing + 'com.gomath.mathlab AdHoc'
    # profile 매핑이 archive·export 양쪽에 동일 적용되게 (Xcode 15+ release-testing
    # 자동 변환과 capability 누락 오류 회피).
    sh(shorebird_cmd("release ios -- --export-options-plist=ios/exportOptions-adhoc.plist"))

    firebase_app_distribution(
      app: "1:421762663548:ios:20d3e33da071d49bff35f9",
      groups: "testers",
      ipa_path: latest_ipa,
      release_notes: release_notes("Build")
    )
  end

  # ========================================
  # Shorebird OTA Patch (재설치 불필요)
  # ========================================

  desc "OTA patch via Shorebird (no reinstall needed)"
  lane :patch do
    # --allow-asset-diffs: 환경 차이로 인한 사소한 asset 차이 허용.
    # --export-options-plist: archive·export profile 매핑 통일.
    sh(shorebird_cmd("patch ios --allow-asset-diffs --export-options-plist=ios/exportOptions-adhoc.plist"))
    UI.success("✅ iOS OTA patch deployed! 테스터 앱 자동 업데이트.")
  end

  # ========================================
  # App Store 배포
  # ========================================

  desc "Deploy to App Store (submit for review)"
  lane :deploy_app_store do
    ensure_api_key
    # --export-options-plist 미지정 시 Xcode 가 pbxproj 의 AdHoc profile 을
    # 그대로 사용 → "iOS App Store profile 이 아니다" 에러로 IPA 생성 실패.
    # 그 상태에서 deliver 가 build/ios/ipa/ 에 남아 있던 이전 AdHoc IPA 를
    # 잘못 업로드해 App Store Connect 에서 무효 처리되는 버그가 있었음.
    sh(shorebird_cmd("release ios -- --export-options-plist=ios/exportOptions-appstore.plist"))

    deliver(
      ipa: latest_ipa,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      # App Store Connect API Key는 IAP precheck를 지원하지 않으므로 비활성화.
      # 업로드 자체에는 영향 없음 (TestFlight/심사 제출 시 별도로 검증됨).
      run_precheck_before_submit: false
    )

    UI.success("✅ App Store에 빌드 업로드 완료! App Store Connect에서 심사 제출하세요.")
  end
end
