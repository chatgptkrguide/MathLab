rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(text, maxLength) {
      return text is string && text.size() <= maxLength;
    }

    // Users collection
    match /users/{userId} {
      // 사용자는 자신의 데이터만 읽고 쓸 수 있음
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasAll(['email', 'displayName', 'createdAt']) &&
        isValidString(request.resource.data.displayName, 100);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // User stats subcollection
      match /stats/{statId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      // User progress subcollection
      match /progress/{progressId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // Lessons collection (읽기 전용)
    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if false; // 관리자만 Firebase Console에서 수정
    }

    // Problems collection (읽기 전용)
    match /problems/{problemId} {
      allow read: if isAuthenticated();
      allow write: if false; // 관리자만 Firebase Console에서 수정
    }

    // Units collection (읽기 전용)
    match /units/{unitId} {
      allow read: if isAuthenticated();
      allow write: if false; // 관리자만 Firebase Console에서 수정
    }

    // Badges collection (읽기 전용)
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if false; // 관리자만 Firebase Console에서 수정
    }

    // Leagues collection
    match /leagues/{leagueId} {
      allow read: if isAuthenticated();
      allow write: if false; // 시스템이 자동 생성

      // League members subcollection
      match /members/{userId} {
        allow read: if isAuthenticated();
        allow write: if isOwner(userId); // 사용자는 자신의 리그 참여 정보만 업데이트
      }
    }

    // User submissions
    match /submissions/{submissionId} {
      allow read: if isAuthenticated() &&
        resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // 제출 후 수정 불가
    }

    // Achievements
    match /achievements/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // 기본적으로 모든 접근 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
