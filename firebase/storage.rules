rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isSizeValid(maxSizeMB) {
      return request.resource.size < maxSizeMB * 1024 * 1024;
    }

    // User profile images
    match /users/{userId}/profile/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        isImage() &&
        isSizeValid(5); // 5MB 제한
    }

    // User avatars (smaller size)
    match /users/{userId}/avatar/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        isImage() &&
        isSizeValid(2); // 2MB 제한
    }

    // Problem images (관리자 전용)
    match /problems/{problemId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false; // Firebase Console에서만 업로드
    }

    // Lesson images (관리자 전용)
    match /lessons/{lessonId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false; // Firebase Console에서만 업로드
    }

    // Badge images (관리자 전용)
    match /badges/{badgeId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if false; // Firebase Console에서만 업로드
    }

    // User generated content (그림판, 풀이 과정 등)
    match /user-content/{userId}/{contentId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) &&
        isImage() &&
        isSizeValid(10); // 10MB 제한
    }

    // Temporary uploads (24시간 후 자동 삭제 예정)
    match /temp/{userId}/{fileName} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) &&
        isSizeValid(5); // 5MB 제한
    }

    // 기본적으로 모든 접근 거부
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
