# MathLab Production Environment Variables
# ⚠️  프로덕션 배포 전 실제 값으로 반드시 변경하세요!
#
# 사용 방법:
# 1. 이 파일을 .env.production으로 복사
# 2. 실제 프로덕션 값으로 모든 변수 변경
# 3. .env.production 파일은 절대 Git에 커밋하지 마세요!

# ========================================
# API Configuration
# ========================================
# 프로덕션 API 서버 URL
API_BASE_URL=https://api.mathlab.app/api/v1

# ========================================
# ========================================
# https://developers.kakao.com
#
# 필수 설정:
# - 플랫폼 > Android: 패키지명, 키 해시
# - 플랫폼 > iOS: Bundle ID
# - 활성화 설정 > 카카오 로그인 활성화

# ========================================
# Social Login - Google
# ========================================
# Google Cloud Console에서 발급
# https://console.cloud.google.com
#
# 필수 설정:
# - OAuth 2.0 클라이언트 ID 생성
# - Android: SHA-1 인증서 지문 등록
# - iOS: Bundle ID, App Store ID 등록
GOOGLE_WEB_CLIENT_ID=your_production_google_web_client_id

# ========================================
# Firebase Configuration
# ========================================
# Firebase Console에서 프로젝트별로 관리
# https://console.firebase.google.com
#
# ⚠️  주의:
# - google-services.json (Android)
# - GoogleService-Info.plist (iOS)
# 파일들은 Firebase Console에서 직접 다운로드하여 사용
#
# 이 파일에는 Firebase 설정을 포함하지 않습니다.

# ========================================
# App Configuration
# ========================================
# 환경: production (배포용)
APP_ENV=production

# App 버전 (pubspec.yaml과 동일하게 유지)
APP_VERSION=1.0.0

# Build 번호
BUILD_NUMBER=1

# ========================================
# Feature Flags
# ========================================
# 프로덕션에서는 디버그 기능 비활성화
ENABLE_LOGGING=false
ENABLE_DEBUG_MODE=false
ENABLE_PERFORMANCE_OVERLAY=false

# Analytics 활성화
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true

# ========================================
# Security
# ========================================
# API 요청 타임아웃 (밀리초)
API_TIMEOUT=30000

# 최대 재시도 횟수
MAX_RETRY_ATTEMPTS=3

# SSL Pinning 활성화 (권장)
ENABLE_SSL_PINNING=true

# ========================================
# Performance
# ========================================
# 이미지 캐시 크기 (MB)
IMAGE_CACHE_SIZE=100

# 최대 동시 다운로드 수
MAX_CONCURRENT_DOWNLOADS=3

# ========================================
# 참고 사항
# ========================================
#
# 1. 환경 변수 로딩:
#    - flutter_dotenv 패키지 사용
#    - main.dart에서 await dotenv.load(fileName: ".env.production");
#
# 2. 보안 주의사항:
#    - 민감한 키는 절대 Git에 커밋하지 마세요
#    - .gitignore에 .env.production이 포함되어 있는지 확인
#    - 프로덕션 키는 별도로 안전하게 보관
#
# 3. 빌드 시 환경 변수:
#    - Android: build.gradle.kts에서 사용 가능
#    - iOS: Xcode scheme에서 설정 가능
#
# 4. Firebase 설정:
#    - Android: google-services.json
#    - iOS: GoogleService-Info.plist
#    - 이 파일들은 .gitignore에 포함되어야 합니다
#
# 5. 소셜 로그인 콜백 URL:
#    - 각 플랫폼에서 앱의 Bundle ID/Package Name 등록 필수
#    - Redirect URI 설정 확인
