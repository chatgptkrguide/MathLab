# MathLab Environment Variables Template
#
# 사용 방법:
# 1. 이 파일을 .env로 복사: cp .env.template .env
# 2. 아래 값들을 실제 값으로 교체
# 3. .env 파일은 절대 Git에 커밋하지 마세요!
#
# ⚠️  보안 주의사항:
# - 이 템플릿 파일에는 실제 키를 입력하지 마세요
# - .env 파일은 .gitignore에 포함되어 있습니다
# - 프로덕션 환경에서는 .env.production 파일을 사용하세요

# ========================================
# API Configuration
# ========================================
API_BASE_URL=http://localhost:8080/api/v1
# Production: https://api.mathlab.app/api/v1

# ========================================
# Social Login Keys
# ========================================
# Kakao Developers Console: https://developers.kakao.com
KAKAO_NATIVE_APP_KEY=your_kakao_native_app_key_here

# Google Cloud Console: https://console.cloud.google.com
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# ========================================
# Firebase Cloud Messaging
# ========================================
# Firebase Console: https://console.firebase.google.com
FCM_WEB_PUSH_KEY=your_fcm_web_push_key_here
FCM_SENDER_ID=your_fcm_sender_id_here

# ========================================
# App Configuration
# ========================================
APP_ENV=development
# Options: development | staging | production

# ========================================
# Debug Settings
# ========================================
ENABLE_LOGGING=true

# ========================================
# OpenAI API (Development Only)
# ========================================
# ⚠️  WARNING: NEVER use client-side OpenAI API in production
# ⚠️  This should ONLY be used for local development/testing
# ⚠️  Production should use backend API with server-side key management
#
# OpenAI Platform: https://platform.openai.com/api-keys
#
# 보안 권장사항:
# 1. 새로운 개발 전용 API 키 생성
# 2. Usage limits 설정 ($10/month 이하 권장)
# 3. Rate limiting 활성화
# 4. 프로덕션 배포 전 반드시 제거
OPENAI_API_KEY=your_openai_api_key_for_dev_only

# ========================================
# 프로덕션 체크리스트
# ========================================
# [ ] 모든 API 키가 설정되었는가?
# [ ] .env 파일이 .gitignore에 포함되어 있는가?
# [ ] OpenAI 키가 개발 전용인가?
# [ ] 프로덕션 환경에서는 .env.production을 사용하는가?
# [ ] Firebase 설정 파일들이 .gitignore에 포함되어 있는가?
